# Copier en .env puis compléter.

APP_ENV=development
CORS_ORIGINS=["http://localhost:5173"]
# Hôtes acceptés par l'API en plus de 127.0.0.1, localhost et [::1] (docs/SUITE.md §5.1), séparés par des virgules.
ALLOWED_HOSTS=

# --- Ollama (local) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT_SECONDS=120

# --- Claude ---
# cli : via la CLI Claude Code (`claude -p`), facturé sur votre abonnement claude.ai (Pro/Max).
#       Prérequis : Claude Code installé et `claude auth login` fait avec votre compte claude.ai.
# api : via l'API Anthropic, avec une clé de la Console Claude (facturation API séparée).
CLAUDE_MODE=cli

# Mode cli — exécutable : chemin absolu (un chemin relatif est refusé) ou « claude » (recherché dans le PATH)
CLAUDE_CLI_PATH=claude
CLAUDE_CLI_MODEL=sonnet
CLAUDE_CLI_TIMEOUT_SECONDS=180

# Mode api
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_MAX_TOKENS=2048

# --- Routage IA ---
# true = si Ollama échoue en mode "auto", on retente sur Claude (envoie les données au cloud).
AI_ALLOW_CLOUD_FALLBACK=false

# --- Données locales (base DuckDB, rapports JSON, réglages) ---
DATA_DIR=data
MAX_UPLOAD_MB=50

# --- GitHub (synchronisation des rapports, jalon 6) ---
GITHUB_TOKEN=

# --- Connecteurs (SQL Server, PostgreSQL, MySQL, SQLite, fichiers, SharePoint) ---
# Secrets : trousseau du système ("auto"), ou fichier data/secrets.json en 0600 ("file").
SECRETS_BACKEND=auto
CONNECTOR_MAX_ROWS=2000000
CONNECTOR_QUERY_TIMEOUT_SECONDS=300
# SharePoint Online : application Entra ID (client public, Sites.Read.All + Files.Read.All déléguées). Voir README.
SHAREPOINT_CLIENT_ID=
SHAREPOINT_TENANT=organizations

# --- Suite Atelier (docs/SUITE.md §4) ---
# Dossier où l'application de bureau Atelier Tab publie ses tables (instantanés DataFlow).
ATELIER_TAB_EXPORTS_DIR=~/Atelier_Tab/exports
# Taille maximale d'un instantané (Mo) : le JSON est chargé en mémoire en entier.
ATELIER_TAB_MAX_SNAPSHOT_MB=50
# API locale d'Atelier Projets (lecture seule, sans secret).
ATELIER_PROJETS_URL=http://127.0.0.1:3000

# --- Alertes ---
# Notifications système au déclenchement (centre de notifications macOS, notify-send sous Linux).
SYSTEM_NOTIFICATIONS=true
